# Copy to payroll/.env and fill in. Never commit the real file.

# Sandbox v1 is deprecated (docs.wise.com/guides/developer/environments/sandbox-v2-migration).
# Use Sandbox v2 credentials/base URL for all dev work; switch WISE_API_BASE to
# https://api.wise.com only when you are deliberately running live.
WISE_API_BASE=https://api.wise-sandbox.com

WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_PRIVATE_KEY_PATH=payroll/keys/private.pem

# Currency TDM funds transfers from (the company's Wise balance currency).
WISE_SOURCE_CURRENCY=GBP
